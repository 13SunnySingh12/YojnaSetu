# Copy to .env (gitignored) and fill in locally. Never commit real values.
# Deployed services read the same names from Render/Vercel environment settings.

# --- MongoDB Atlas (Spring Boot backend + FastAPI AI service + ingestion) ---
MONGODB_URI=
MONGODB_DATABASE=yojnasetu

# --- Internal auth: Spring Boot -> FastAPI. Must be the SAME value in both services. ---
AI_SERVICE_TOKEN=

# --- Spring Boot backend ---
AI_SERVICE_URL=http://localhost:8000
# Comma-separated browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173

# --- FastAPI AI service (keys stay server-side) ---
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional model overrides (defaults live in AI/app/config.py)
# GEMINI_EMBEDDING_MODEL=
# GEMINI_CHAT_MODEL=
# GROQ_CHAT_MODEL=

# --- Government data ingestion ---
# data.gov.in OGD API key (free, from your data.gov.in account page)
DATA_GOV_IN_API_KEY=
# API Setu credentials for the official myScheme API (issued after subscription approval)
APISETU_CLIENT_ID=
APISETU_API_KEY=

# --- Frontend (public, build-time). Set in Frontend/.env.local or the Vercel project. ---
# VITE_API_BASE_URL=http://localhost:8080
